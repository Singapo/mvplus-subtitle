# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.cookie
*_cookies.txt

# Local configuration written by the user
mvsub.toml

# Pipeline state and caches
work/
translation_memory.json
*.alignment.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

