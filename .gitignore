# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example
*.cookie
*_cookies.txt

# Local configuration written by the user.
# The rule is deliberately anchored to the repository root: an unanchored
# `mvsub.toml` also matched `examples/mvsub.toml` and silently kept the shipped
# example out of the release.
/mvsub.toml
!/examples/mvsub.toml

# Scratch files used while writing a commit or release note.
# They live in the repo root for `git commit -F`, and without these rules they
# end up inside the very commit they describe.
/.cm-*.txt
/.commit-msg*.txt
/.rn-*.txt
/.release-notes*.txt

# Pipeline state and caches
work/
translation_memory.json
*.alignment.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
build/
dist/

# Model binaries and runtime libs (fetched separately, never vendored)
models/
lib/cuda/
*.bin
*.safetensors

# Media
*.srt
*.ass
*.vtt
*.wav
*.mp3
*.mp4
*.mkv
*.m4a

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local-only test scaffolding (throwaway venv, dsh plugin dev link, smoke test)
.local-test/
.local-venv/
dsh/node_modules/
dsh/smoke.local.mjs
