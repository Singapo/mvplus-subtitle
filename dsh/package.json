{
  "name": "dsh-plugin-mvplus-subtitle",
  "version": "0.1.0",
  "description": "DeepSeek Harness tools for the mvplus-subtitle pipeline: scan a 115 cloud directory for films without Chinese subtitles, then download, transcribe, align, translate and upload them back",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subtitle",
    "srt",
    "asr",
    "translation"
  ],
  "license": "MIT",
  "author": {
    "name": "Singapo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Singapo/mvplus-subtitle.git",
    "directory": "dsh"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
